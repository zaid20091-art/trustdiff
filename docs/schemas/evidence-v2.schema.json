{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrustDiff verification proof v2",
  "type": "object",
  "required": ["bundle_version", "statement", "report", "signature", "signature_namespace", "attestation"],
  "properties": {
    "bundle_version": {"const": 2},
    "signature_namespace": {"const": "trustdiff-proof-v2@trustdiff.dev"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"},
    "statement": {
      "type": "object",
      "required": ["_type", "subject", "predicateType", "predicate"],
      "properties": {
        "_type": {"const": "https://in-toto.io/Statement/v1"},
        "subject": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "required": ["name", "digest"]}},
        "predicateType": {"const": "https://trustdiff.dev/attestation/verification/v1"},
        "predicate": {
          "type": "object",
          "required": ["report_sha256", "baseline_commit", "policy_sha256", "overall_verdict"],
          "properties": {
            "report_sha256": {"$ref": "#/$defs/sha256"},
            "baseline_commit": {"$ref": "#/$defs/commit"},
            "policy_sha256": {"$ref": "#/$defs/sha256"},
            "overall_verdict": {"enum": ["PASS", "FAIL"]}
          }
        }
      }
    },
    "report": {
      "type": "object",
      "required": ["target_commit", "baseline_commit", "policy_sha256", "overall_verdict", "integrity_verdict", "results", "evidence"],
      "properties": {
        "target_commit": {"$ref": "#/$defs/commit"},
        "baseline_commit": {"$ref": "#/$defs/commit"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "overall_verdict": {"enum": ["PASS", "FAIL"]},
        "integrity_verdict": {"const": "PASS"},
        "results": {"type": "array", "items": {"type": "object"}},
        "evidence": {"type": "array", "items": {"type": "object"}}
      }
    },
    "attestation": {
      "type": "object",
      "required": ["principal", "key_id", "signed_at", "verifier", "target_commit", "baseline_commit", "policy_sha256"],
      "properties": {
        "principal": {"type": "string", "minLength": 1},
        "key_id": {"type": "string", "minLength": 1},
        "signed_at": {"type": "string", "format": "date-time"},
        "target_commit": {"$ref": "#/$defs/commit"},
        "baseline_commit": {"$ref": "#/$defs/commit"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "verifier": {
          "type": "object",
          "required": ["name", "version", "manifest_sha256"],
          "properties": {
            "name": {"const": "trustdiff"},
            "version": {"type": "string"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
